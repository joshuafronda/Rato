# Copy to .env (git-ignored) and fill in. Read by npm start and npm run dev.

# Online gallery (Firebase). Leave empty to keep the booth fully offline.
FIREBASE_BUCKET=rato-d2428.firebasestorage.app
# Path to the service account key, with forward slashes (a backslash starts an escape here).
# Keep the key OUTSIDE this folder and never commit it.
FIREBASE_KEY_FILE=C:/rato-keys/rato-firebase-key.json

# This booth's name in the online gallery. Several booths can share one gallery as long as
# each has its own name. Empty = the computer name. Letters, digits and dashes.
BOOTH_ID=
