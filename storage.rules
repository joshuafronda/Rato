rules_version = '2';

// Firebase Storage rules for the online gallery. Phones may only fetch a strip (in its booth's
// folder) or the gallery index by its exact name: no listing, and no writes. The booth laptops
// upload with their service account key, which these rules do not apply to.
service firebase.storage {
  match /b/{bucket}/o {
    match /strips/{booth}/{file} {
      allow get: if true;
    }
    match /gallery.json {
      allow get: if true;
    }
  }
}
