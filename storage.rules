rules_version = '2';

// Firebase Storage rules for the online gallery. Phones may only fetch a shared strip or the
// gallery index by its exact name: no listing, and no writes. The booth laptop uploads with
// its service account key, which these rules do not apply to.
service firebase.storage {
  match /b/{bucket}/o {
    match /strips/{file} {
      allow get: if true;
    }
    match /gallery.json {
      allow get: if true;
    }
  }
}
